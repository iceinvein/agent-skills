<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="WelcomeEmailEnabled" value="true" />
    <add key="NightlyDigestCutoffDays" value="30" />
  </appSettings>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=.;Initial Catalog=TinyWebForms;Integrated Security=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
