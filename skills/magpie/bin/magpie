#!/usr/bin/env bash
# Resolve symlinks so we find the real magpie.ts even when invoked via
# a /usr/local/bin or ~/.local/bin symlink.
SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  TARGET="$(readlink "$SCRIPT")"
  if [[ "$TARGET" = /* ]]; then
    SCRIPT="$TARGET"
  else
    SCRIPT="$DIR/$TARGET"
  fi
done
DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
ROOT="$(dirname "$DIR")"

# A plugin install puts bin/ on PATH without running install.sh, so the
# first run has to fetch runtime dependencies itself. Progress goes to stderr
# because callers parse magpie's stdout. The gate is a marker written after
# success, not node_modules itself, because a failed or killed install leaves
# node_modules behind and the next run would skip straight to a crash.
MARKER="$ROOT/node_modules/.magpie-deps-installed"
if [ -f "$ROOT/package.json" ] && [ ! -f "$MARKER" ]; then
  echo "Installing magpie runtime dependencies..." >&2
  (cd "$ROOT" && bun install --production --silent) >&2 || {
    echo "magpie: bun install failed in $ROOT" >&2
    exit 1
  }
  touch "$MARKER"
fi

exec bun "$DIR/magpie.ts" "$@"
